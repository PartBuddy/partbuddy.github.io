---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { ArrowUpRight, Download, Plus, MessageCircleQuestionMark, SlidersHorizontal, PenTool, CreditCard } from '@lucide/astro';
import { RELEASED, SITE_URL, DOWNLOAD_URL } from '../config';
import { channels, KOFI_URL, steps, highlights, more, models, roadmap } from '../data/site';
import { getReleases } from '../lib/releases';

const releases = await getReleases();
const latest = releases[0];
const icons = { messageCircleQuestion: MessageCircleQuestionMark, slidersHorizontal: SlidersHorizontal, penTool: PenTool, creditCard: CreditCard };

const title = 'PartBuddy · Design printable parts by talking to an assistant';
const description =
  'PartBuddy is a free CAD app for Windows. Describe a 3D-print part, watch it being built step by step, and send it to your slicer. Runs on your Claude or ChatGPT subscription or a local model.';

const faq = [
  { q: 'What does it cost?', a: [RELEASED ? 'Nothing. PartBuddy is free and open source under the GPL-3.0 licence.' : 'Nothing. PartBuddy is free.', 'The assistant runs on a subscription you already have or on a local model. PartBuddy adds no fees of its own.'] },
  { q: 'Which subscription do I need?', a: ['Claude Pro or Max (through Claude Code), or ChatGPT Plus or Pro. With a local model you need none of them.'] },
  { q: 'Can it run locally?', a: [`Yes, with ${models.local.slice(0, -1).join(', ')} or ${models.local.at(-1)}. ${models.localNote}`] },
  { q: 'Does it do supports and print orientation?', a: ['No, on purpose. That is slicer work, and your slicer knows your printer profile. PartBuddy designs the part, checks what can only be decided while designing, and opens it in Bambu Studio or OrcaSlicer.'] },
  { q: 'Does it run only on Windows?', a: ['Yes. PartBuddy is a Windows desktop app.'] },
  { q: 'What is SolidCraft?', a: ['The CAD engine behind PartBuddy. It builds the geometry; PartBuddy runs it in the background and shows every step in its own 3D view. You install SolidCraft yourself, and the setup on first start helps you find it.'] },
  ...(RELEASED ? [{ q: 'Why does Windows warn about the installer?', a: ['PartBuddy is a hobby project and its installer is not code-signed, so Windows SmartScreen may show a warning. Choose More info, then Run anyway. The source code is public.'] }] : []),
  { q: 'Is my design private?', a: ['Your projects are files in a folder on your computer. With a subscription, what a chat sends goes to that provider under their terms; with a local model it stays on your machine.'] },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'PartBuddy',
  description,
  url: `${SITE_URL}/`,
  image: `${SITE_URL}/social-preview.png`,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Windows',
  inLanguage: ['en', 'de'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  sameAs: channels.map((c) => c.url),
  ...(RELEASED ? { downloadUrl: DOWNLOAD_URL, license: 'https://www.gnu.org/licenses/gpl-3.0.html' } : {}),
  ...(latest ? { softwareVersion: latest.version } : {}),
};
---
<Base title={title} description={description} nav jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <h1>Design printable parts by talking to an assistant.</h1>
        <p class="lede">PartBuddy is a free CAD app for Windows. Describe the part, watch it being built step by step, and send it to your slicer.</p>
        <div class="actions">
          {RELEASED
            ? <a class="btn btn-primary btn-lg" href={DOWNLOAD_URL}><Download aria-hidden="true" />Download for Windows</a>
            : <a class="btn btn-primary btn-lg" href="#follow">Coming soon – follow along</a>}
        </div>
        <p class="hero-note">{RELEASED && latest ? `Version ${latest.version} · ` : ''}Works with your Claude or ChatGPT subscription, or a local model.</p>
      </div>
      <div class="hero-media"><HeroMedia /></div>
    </div>
  </section>

  <section id="how" class="band">
    <div class="wrap">
      <h2 class="section-title">How it works</h2>
      <div class="steps" data-steps>
        <div class="step-tabs" role="tablist" aria-label="Steps">
          {steps.map((s, i) => (
              <button class="step-tab" role="tab" type="button" id={`step-tab-${i}`} aria-controls={`step-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span class="step-no">{i + 1}</span>
                <span><strong>{s.title}</strong><span class="step-text">{s.text}</span></span>
              </button>
          ))}
        </div>
        <div class="step-panels">
          {steps.map((s, i) => (
            <div class:list={['step-panel', { 'is-active': i === 0 }]} id={`step-${i}`} role="tabpanel" aria-labelledby={`step-tab-${i}`}>
              <div class="step-caption"><span class="step-no">{i + 1}</span><span><strong>{s.title}</strong><span class="step-text">{s.text}</span></span></div>
              <Shot name={s.shot} alt={s.alt} sizes="(min-width: 1152px) 680px, (min-width: 960px) 60vw, 100vw" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <h2 class="section-title">Why makers like it</h2>
      <div class="highlights">
        {highlights.map((h) => {
          const Icon = icons[h.icon as keyof typeof icons];
          return (
            <article class="highlight">
              <span class="icon"><Icon aria-hidden="true" /></span>
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </article>
          );
        })}
      </div>

      <h3 class="more-title">Also in the app</h3>
      <dl class="more">
        {more.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="next">Coming next: {roadmap.next.join(', ')}. Ideas for later: {roadmap.later.join(', ')}.</p>
    </div>
  </section>

  <section id="follow" class="band">
    <div class="wrap follow">
      <div>
        <h2 class="section-title">{RELEASED ? 'Built in public' : 'Coming soon. Built in public.'}</h2>
        <p class="muted">New features, real printed parts, and the things that went wrong.</p>
        <p class="kofi">Want to help? <a href={KOFI_URL}>Support PartBuddy on Ko-fi</a>. Entirely voluntary.</p>
      </div>
      <ul class="channels">
        {channels.map((c) => (
          <li>
            <a class="channel" href={c.url} rel="me">
              <span><strong>{c.name}</strong><span class="muted">{c.handle}</span></span>
              <ArrowUpRight aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <h2 class="section-title">Questions</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}<Plus aria-hidden="true" /></summary>
            {f.a.map((p) => <p>{p}</p>)}
          </details>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      // Steps: tabs on wide screens (all panels stay visible without JS and on phones).
      const tabs = [...document.querySelectorAll('.step-tab')];
      const show = (i, focus) => tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', on); t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).classList.toggle('is-active', on);
        if (on && focus) t.focus();
      });
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(i));
        t.addEventListener('keydown', (e) => {
          const d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
          if (d) { e.preventDefault(); show((i + d + tabs.length) % tabs.length, true); }
        });
      });
    })();
  </script>
</Base>
