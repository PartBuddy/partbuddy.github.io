---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Brand from '../components/Brand.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowRight, ArrowUpRight, Download, Plus, Check, X, Minus, FolderLock, Cpu, EyeOff, Play, Star } from '@lucide/astro';
import { RELEASED, SITE_URL, DOWNLOAD_URL, MAC_URL, REPO_URL, STARS, latest } from '../config';
import { channels, KOFI_URL, SOLIDCRAFT, hero, worksWith, chapters, standards, bento, privacy, models, roadmap as status } from '../data/site';
import { compare } from '../data/compare';

const privacyIcons = [FolderLock, Cpu, EyeOff];
const markIcon = { yes: Check, no: X, part: Minus };
const markLabel = { yes: 'Yes', no: 'No', part: 'Partly' };

// The produced build film (src/assets/shots/hero.mp4 + hero-poster.png) opens in a dialog.
const videos = import.meta.glob<string>('../assets/shots/hero.mp4', { eager: true, query: '?url', import: 'default' });
const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/hero-poster.png', { eager: true });
const film = Object.values(videos)[0];
const posterSrc = Object.values(posters)[0]?.default;
const poster = posterSrc && (await getImage({ src: posterSrc, width: Math.min(1100, posterSrc.width), format: 'webp', quality: 70 }));

const title = 'PartBuddy · Parts that fit. First print.';
const description =
  'PartBuddy is a free CAD app for Windows: describe the part you need, and its assistant asks what matters, builds real, editable CAD while you watch, and checks it against your printer. ISO fasteners and material fits built in. Runs on your Claude or ChatGPT plan or a local model.';

const faq = [
  { q: 'What does it cost?', a: [RELEASED ? 'Nothing. PartBuddy is free and open source under the GPL-3.0 licence.' : 'Nothing. PartBuddy is free.', 'The assistant runs on a subscription you already have or on a local model. PartBuddy adds no fees of its own.'] },
  { q: 'Which subscription do I need?', a: ['Claude Pro or Max (through Claude Code), or ChatGPT Plus or Pro. With a local model you need none of them.'] },
  { q: 'Can it run locally?', a: [`Yes, with ${models.local.slice(0, -1).join(', ')} or ${models.local.at(-1)}. ${models.localNote}`] },
  { q: 'Is the result real CAD or a mesh?', a: ['Real CAD. SolidCraft builds editable solid geometry with a full history, so you can change any size later and export STEP for other CAD programs as well as 3MF and STL for printing.'] },
  { q: 'Does it do supports and print orientation?', a: ['No, on purpose. That is slicer work, and your slicer knows your printer profile. PartBuddy designs the part, checks what can only be decided while designing, and opens it in Bambu Studio or OrcaSlicer.'] },
  { q: 'Does it run only on Windows?', a: MAC_URL
    ? ['Windows is the main platform. Since 0.3.1 there is also an experimental build for macOS (Apple silicon and Intel): <a href="' + MAC_URL + '">download the dmg</a>. It is not signed by Apple and gets no automatic updates, and so far only its start has been tested, so feedback is welcome.', 'macOS blocks the first start: open System Settings, then Privacy & Security, and choose Open Anyway. SolidCraft has its own Mac build.']
    : ['Yes. PartBuddy is a Windows desktop app.'] },
  { q: 'What is SolidCraft?', a: ['The CAD engine behind PartBuddy. It builds the geometry; PartBuddy runs it in the background and shows every step in its own 3D view. You install SolidCraft yourself, and the setup on first start helps you find it.'] },
  { q: 'Which SolidCraft version do I need?', a: [`SolidCraft ${SOLIDCRAFT.version}. Download SolidCraft-${SOLIDCRAFT.version}-windows-x64.exe from <a href="${SOLIDCRAFT.url}">its release page</a>. The release marked “Latest” on SolidCraft’s GitHub page can be newer than the version PartBuddy is tested with.`, `PartBuddy needs SolidCraft 0.40.1 or newer and does not start with older versions.`] },
  { q: 'Why not connect Claude or ChatGPT to SolidCraft directly?', a: ['You can: SolidCraft has its own MCP server, and PartBuddy drives the same engine. What PartBuddy adds is everything around it.', 'It asks about loads, fits and real sizes and shows a plan before it builds. It checks every change against your printer and material. ISO fasteners, inserts and fits measured on your printer are built in. You click a face and pin a note to it, so the assistant knows exactly which face you mean, even after a rebuild.', 'The assistant works only through PartBuddy’s checks and only in your project folder. Every step can be taken back, versions can be compared, and the part goes straight to your slicer. And there is nothing to configure: sign in with your plan and start.'] },
  ...(RELEASED ? [{ q: 'Why does Windows warn about the installer?', a: ['PartBuddy is a hobby project and its installer is not code-signed, so Windows SmartScreen may show a warning. Choose More info, then Run anyway. The source code is public.'] }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'PartBuddy',
  description,
  url: `${SITE_URL}/`,
  image: `${SITE_URL}/og.png`,
  applicationCategory: 'DesignApplication',
  operatingSystem: MAC_URL ? 'Windows, macOS' : 'Windows',
  inLanguage: ['en', 'de'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  sameAs: channels.map((c) => c.url),
  ...(RELEASED ? { downloadUrl: DOWNLOAD_URL, license: 'https://www.gnu.org/licenses/gpl-3.0.html' } : {}),
  ...(latest ? { softwareVersion: latest.version } : {}),
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-copy">
      {latest
        ? latest.news
          ? <a class="eyebrow" href="#new"><span class="tag">New in {latest.version}</span>{latest.news.headline}<ArrowRight aria-hidden="true" /></a>
          : <a class="eyebrow" href="/changelog.html"><span class="tag">{latest.version}</span>Released {latest.dateLabel}<ArrowRight aria-hidden="true" /></a>
        : <a class="eyebrow" href="#follow"><span class="dot" aria-hidden="true"></span>In development · Built in public<ArrowRight aria-hidden="true" /></a>}
      <h1 id="hero-title">{hero.title[0]}<br /><span>{hero.title[1]}</span></h1>
      <div class="hero-side">
        <p class="sub">{hero.sub}</p>
        <div class="ctas">
          {RELEASED
            ? <a class="btn btn-primary btn-lg" href={DOWNLOAD_URL} data-goatcounter-click="download-windows"><Download aria-hidden="true" />Download for Windows</a>
            : <a class="btn btn-primary btn-lg" href="#follow">Follow the build</a>}
          {film
            ? <button class="btn btn-lg" type="button" data-film-open><Play aria-hidden="true" />Watch it build</button>
            : <a class="btn btn-lg" href="#product">See how it works</a>}
        </div>
        <p class="fine">{hero.fine}{MAC_URL && <> · <a href={MAC_URL} data-goatcounter-click="download-mac">macOS test build</a></>}</p>
        {RELEASED && <p class="fine">Needs the free CAD engine <a href={SOLIDCRAFT.url}>SolidCraft {SOLIDCRAFT.version}</a>.</p>}
      </div>
    </div>
    <div class="stage">
      <Shot name="clarify" full eager class="window" sizes="(min-width: 1360px) 1300px, (min-width: 760px) 94vw, 190vw"
        alt="The PartBuddy window: parameters, a housing around a circuit board in the 3D view, and the assistant asking how the lid should hold" />
    </div>
    <div class="wrap works">
      <p>Works with</p>
      <ul class="logos">{worksWith.map((w) => <li class="logo"><Brand name={w} />{w}</li>)}</ul>
    </div>
  </section>

  {latest?.news && (
    <section id="new" class="update-wrap" aria-labelledby="new-title">
      <div class="wrap">
        <article class:list={['update reveal', { 'update-shot': latest.news.shot }]}>
          <div class="update-text">
            <p class="update-head"><span class="update-tag">New in {latest.version}</span><time datetime={latest.date}>{latest.dateLabel}</time></p>
            <h2 id="new-title">PartBuddy {latest.version} is out.</h2>
            <ol class="update-items">
              {latest.news.items.map((i) => <li>{i.title && <h3>{i.title}</h3>}<p>{i.text}</p></li>)}
            </ol>
            <div class="ctas">
              <a class="btn btn-primary" href={DOWNLOAD_URL} data-goatcounter-click="download-update"><Download aria-hidden="true" />Get {latest.version}</a>
              <a class="btn" href={`/changelog.html#v${latest.version}`}>All changes<ArrowRight aria-hidden="true" /></a>
            </div>
          </div>
          {latest.news.shot && <Shot name={latest.news.shot} alt={latest.news.headline} sizes="(min-width: 1200px) 620px, (min-width: 960px) 50vw, 100vw" />}
        </article>
      </div>
    </section>
  )}

  <section id="product" class="section section-alt" aria-labelledby="product-title">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">How it works</p>
        <h2 id="product-title">From a sentence to the print bed.</h2>
        <p>One workspace, four steps. Everything you see is the app as it is today.</p>
      </header>
      <div class="chapters">
        {chapters.map((c, i) => (
          <article class="chapter" aria-labelledby={`ch-${i}`}>
            <div class="chapter-text reveal">
              <p class="kicker"><span class="no">0{i + 1}</span>{c.kicker}</p>
              <h2 id={`ch-${i}`}>{c.title}</h2>
              <p>{c.text}</p>
              <ul class="points">{c.points.map((p) => <li><Check aria-hidden="true" />{p}</li>)}</ul>
            </div>
            <div class="chapter-shot reveal">
              <Shot name={c.shot} alt={c.alt} sizes="(min-width: 1200px) 760px, (min-width: 960px) 60vw, 100vw" />
            </div>
            {c.kicker === 'Check' && (
              <div class="spec reveal" style="grid-column: 1 / -1">
                <div>
                  <h3>Fits per material · clearance per side, mm</h3>
                  <table class="fits">
                    <thead><tr><th scope="col">Material</th><th scope="col">Clamp</th><th scope="col">Push</th><th scope="col">Slide</th><th scope="col">Turn</th><th scope="col">Overhang</th></tr></thead>
                    <tbody>{standards.fits.map((r) => <tr><th scope="row">{r.material}</th>{r.fits.map((v) => <td>{v}</td>)}<td>{r.overhang}</td></tr>)}</tbody>
                  </table>
                  <p class="note">The defaults. Your printer and material profile changes them.</p>
                </div>
                <div>
                  <h3>Screws, nuts and inserts</h3>
                  <dl>{[...standards.fasteners.slice(0, 4), ...standards.inserts.slice(0, 2).map(([k, v]) => [`Insert ${k}`, v])].map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
                  <p class="note">{standards.insertNote}</p>
                </div>
                <div>
                  <h3>Designed to print without supports</h3>
                  <ul>{standards.supportFree.map((s) => <li><Check aria-hidden="true" />{s}</li>)}</ul>
                </div>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="features" class="section" aria-labelledby="bench-title">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Workspace</p>
        <h2 id="bench-title">Everything else on the bench.</h2>
        <p>The parts of a CAD workspace you expect, built for makers.</p>
      </header>
      <div class="bench">
        {bento.map((b) => (
          <article class:list={['tile reveal', `tile-${b.shot}`, { 'tile-wide': b.size === 'wide' }]}>
            <div class="tile-text">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
            <div class="tile-media"><Shot name={b.shot} alt={b.alt} sizes={b.size === 'wide' ? '(min-width: 1040px) 780px, 100vw' : '(min-width: 1040px) 380px, (min-width: 760px) 50vw, 100vw'} /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="compare" class="section section-alt" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Compare</p>
        <h2 id="compare-title">Why not just use …</h2>
        <p>{compare.intro}</p>
      </header>
      <div class="compare-scroll reveal" tabindex="0" role="region" aria-label="Comparison table, scrolls sideways">
        <table class="compare">
          <thead>
            <tr>
              <td></td>
              {compare.columns.map((c, i) => <th scope="col" class:list={{ 'is-us': i === compare.columns.length - 1 }}>{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {compare.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {r.cells.map(([mark, note], i) => {
                  const Icon = markIcon[mark];
                  return (
                    <td class:list={[`m-${mark}`, { 'is-us': i === r.cells.length - 1 }]}>
                      <span class="mark"><Icon aria-hidden="true" /><span class="sr-only">{markLabel[mark]}</span></span>
                      {note && <span class="note">{note}</span>}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare-foot">{compare.footnote}</p>
    </div>
  </section>

  <section id="trust" class="section" aria-labelledby="trust-title">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Privacy</p>
        <h2 id="trust-title">Yours, end to end.</h2>
      </header>
      <div class="trust">
        {privacy.map((p, i) => {
          const Icon = privacyIcons[i];
          return (
            <div class="trust-item reveal">
              <Icon aria-hidden="true" />
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          );
        })}
      </div>
      <div class="status reveal" aria-label="Where PartBuddy stands">
        <div>
          <h3><span class="dot" aria-hidden="true"></span>Works today</h3>
          <ul>{status.today.map((s) => <li>{s}</li>)}</ul>
        </div>
        {status.next.length > 0 && <div>
          <h3><span class="dot dot-next" aria-hidden="true"></span>Next</h3>
          <ul>{status.next.map((s) => <li>{s}</li>)}</ul>
        </div>}
        <div>
          <h3><span class="dot dot-later" aria-hidden="true"></span>Later</h3>
          <ul>{status.later.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div class="release">
          <div>
            <h3>Latest release</h3>
            {latest
              ? <p><strong>{latest.version}</strong></p><time datetime={latest.date}>{latest.dateLabel}</time>
              : <p><strong>Coming soon</strong></p><p>Every release is listed with its changes.</p>}
          </div>
          <a class="link-arrow" href="/changelog.html">Changelog<ArrowRight aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="follow" class="final" aria-labelledby="follow-title">
    <div class="wrap">
      <h2 id="follow-title" class="reveal">Your next part starts with a sentence.</h2>
      <p class="lead reveal">{RELEASED
        ? 'Download PartBuddy for Windows. Free, open source, no account.'
        : 'PartBuddy is in development. Follow the build for new features, real printed parts, and the things that went wrong.'}</p>
      {RELEASED && <div class="ctas">
        <a class="btn btn-primary btn-lg" href={DOWNLOAD_URL} data-goatcounter-click="download-windows"><Download aria-hidden="true" />Download for Windows</a>
        <a class="btn btn-lg" href={REPO_URL} data-goatcounter-click="star-follow"><Star aria-hidden="true" />Star on GitHub{STARS !== undefined && <span class="stars">{STARS}</span>}</a>
      </div>}
      <ul class="channels">
        {channels.map((c) => (
          <li><a class="channel" href={c.url} rel="me"><Brand name={c.name} />{c.name}<span class="sr-only"> {c.handle}</span><ArrowUpRight aria-hidden="true" /></a></li>
        ))}
      </ul>
      <div class="kofi">
        <p>PartBuddy is free and a hobby project. If it saves you a print, you can buy it a coffee. Entirely voluntary.</p>
        <a class="btn" href={KOFI_URL}><Brand name="Ko-fi" />Support on Ko-fi</a>
      </div>
    </div>
  </section>

  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="wrap faq-wrap">
      <h2 id="faq-title">Questions</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}<Plus aria-hidden="true" /></summary>
            {f.a.map((p) => <p set:html={p} />)}
          </details>
        ))}
      </div>
    </div>
  </section>

  {film && (
    <dialog class="film" id="film" aria-label="A sensor housing designed in one chat: questions, step-by-step CAD build, print check and plate">
      <form method="dialog"><button class="btn film-close" aria-label="Close"><X aria-hidden="true" /></button></form>
      <video src={film} poster={poster?.src} controls muted playsinline preload="none" width={posterSrc?.width} height={posterSrc?.height}></video>
    </dialog>
    <script is:inline>
      (() => {
        const d = document.getElementById('film');
        const v = d.querySelector('video');
        document.querySelectorAll('[data-film-open]').forEach((b) => b.addEventListener('click', () => {
          d.showModal();
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) v.play().catch(() => {});
        }));
        d.addEventListener('close', () => v.pause());
        d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
      })();
    </script>
  )}
</Base>
