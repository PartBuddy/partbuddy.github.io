---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { Move3d, Search, PenTool, Puzzle, CircleCheck, FolderOpen, Share2, ArrowUpRight, ArrowDown, Download, Plus } from '@lucide/astro';
import { RELEASED, SITE_URL, DOWNLOAD_URL } from '../config';
import { channels, KOFI_URL, features, aroundIt, models, roadmap } from '../data/site';

const icons = { move3d: Move3d, search: Search, penTool: PenTool, puzzle: Puzzle, circleCheck: CircleCheck, folderOpen: FolderOpen, share2: Share2 };

const title = 'PartBuddy · Design printable FDM parts with an assistant';
const description =
  'PartBuddy is a free Windows desktop app for designing printable FDM parts in a real CAD workspace, with an assistant that asks before it guesses. Runs on your Claude or ChatGPT subscription or a local model.';

const faq = [
  { q: 'Does it run only on Windows?', a: ['Yes. PartBuddy is a Windows desktop app.'] },
  {
    q: 'What does it cost?',
    a: [
      RELEASED
        ? 'Nothing. PartBuddy is free and open source under the GPL-3.0 licence.'
        : 'Nothing. PartBuddy is free.',
      'The assistant runs on a subscription you already have or on a local model. PartBuddy adds no fees of its own.',
    ],
  },
  {
    q: 'Which subscription do I need?',
    a: ['Claude Pro or Max (through Claude Code), or ChatGPT Plus or Pro. With a local model you need none of them.'],
  },
  {
    q: 'Can it run locally?',
    a: [`Yes. PartBuddy works with local models through ${models.local.slice(0, -1).join(', ')} and ${models.local.at(-1)}.`],
  },
  ...(RELEASED
    ? [{ q: 'Why does Windows warn about the installer?', a: ['PartBuddy is a hobby project and its installer is not code-signed, so Windows SmartScreen may show a warning. Choose More info, then Run anyway. The source code is public.'] }]
    : []),
  {
    q: 'What is SolidCraft?',
    a: [
      'SolidCraft is the CAD engine behind PartBuddy. It builds the geometry; PartBuddy runs it without a window and shows every step in its own 3D view.',
      'You install SolidCraft yourself. The setup on first start finds it or links to its download.',
    ],
  },
  {
    q: 'Is my design private?',
    a: [
      'Your projects are files in a folder on your computer. The assistant sees what a chat sends it: with a subscription that goes to its provider under their terms, with a local model it stays on your machine.',
      'A strict local-only mode is on the ideas list.',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'PartBuddy',
  description,
  url: `${SITE_URL}/`,
  image: `${SITE_URL}/social-preview.png`,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Windows',
  inLanguage: ['en', 'de'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  sameAs: channels.map((c) => c.url),
  ...(RELEASED ? { downloadUrl: DOWNLOAD_URL, license: 'https://www.gnu.org/licenses/gpl-3.0.html' } : {}),
};
---
<Base title={title} description={description} nav jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <p class="label mono">Free desktop app for Windows</p>
      <h1>Your part, step by step.</h1>
      <p class="lede">
        PartBuddy is a CAD workspace for printable FDM parts, with an assistant at your side.
        You change dimensions directly. Where it comes down to intent, the assistant asks first, with options and a recommendation.
      </p>
      <div class="actions">
        {RELEASED
          ? <a class="btn btn-primary" href={DOWNLOAD_URL}><Download aria-hidden="true" />Download for Windows</a>
          : <a class="btn btn-primary" href="#follow">Coming soon – follow along</a>}
        <a class="btn" href="#how">How it works<ArrowDown aria-hidden="true" /></a>
      </div>
      <p class="meta mono muted">
        {RELEASED ? 'Free and open source · GPL-3.0 · ' : 'Free · '}Runs on your Claude or ChatGPT subscription, or a local model
      </p>
      <div class="hero-media">
        <HeroMedia />
      </div>
    </div>
  </section>

  <section id="how" class="section-alt">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label mono">01 · How it works</p>
        <h2>Direct where it is unambiguous. The assistant where intent matters.</h2>
      </div>
      <div class="split">
        <article class="panel reveal">
          <h3>You change what is clear</h3>
          <p>A dimension that is driven by a parameter changes at once, with a preview. No request to the assistant, no tokens, no waiting.</p>
          <Shot name="params" alt="Parameters with their values and ranges next to the 3D view" />
        </article>
        <article class="panel reveal">
          <h3>The assistant asks before it guesses</h3>
          <p>When there are several sensible ways, it asks one short question. Each option says what it changes, one is marked as recommended, and you decide.</p>
          <Shot name="clarify" alt="A clarification card with three options, one marked as recommended" />
        </article>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label mono">02 · Features</p>
        <h2>A real CAD workspace, built for makers.</h2>
        <p>SolidCraft builds the geometry. PartBuddy puts the view, the timeline, the parameters and the assistant around it.</p>
      </div>
      <div class="grid">
        {features.map((f) => {
          const Icon = icons[f.icon];
          return (
            <article class:list={['card', 'reveal', { wide: 'wide' in f && f.wide }]}>
              <span class="icon"><Icon aria-hidden="true" /></span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
              <div class="media"><Shot name={f.shot} alt={f.alt} sizes={'wide' in f && f.wide ? '(min-width: 1152px) 620px, (min-width: 760px) 55vw, 100vw' : undefined} /></div>
            </article>
          );
        })}
      </div>
      <p class="around reveal">{aroundIt}</p>
    </div>
  </section>

  <section id="models" class="section-alt">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label mono">03 · Bring your own model</p>
        <h2>Use the subscription you already pay for.</h2>
        <p>PartBuddy has no plan of its own and charges nothing for the assistant. It connects to what you have.</p>
      </div>
      <div class="models">
        <article class="card reveal">
          <span class="tag">Main path</span>
          <h3>Your subscription</h3>
          <p>No API costs on top. With a Claude subscription, PartBuddy shows how much of it you have used.</p>
          <ul>{models.subscriptions.map((m) => <li>{m}</li>)}</ul>
        </article>
        <article class="card reveal">
          <span class="tag">Alternative</span>
          <h3>Local models</h3>
          <p>Runs on your own hardware.</p>
          <ul>{models.local.map((m) => <li class="mono">{m}</li>)}</ul>
        </article>
      </div>
      <p class="note reveal">Model and effort are chosen per chat and can change in the middle of a conversation.</p>
    </div>
  </section>

  <section id="scope">
    <div class="wrap boundary">
      <div class="reveal">
        <p class="label mono">04 · What PartBuddy leaves out</p>
        <h2 style="font-size:clamp(1.75rem,1.2rem + 2.2vw,2.5rem);line-height:1.15">No slicer work. On purpose.</h2>
      </div>
      <div class="prose reveal">
        <p>Supports, bridges, print orientation and calibration belong in the slicer. It knows your printer profile and does them better than a design tool could.</p>
        <p>PartBuddy designs the geometry, checks what can only be decided while designing, and hands the part over. Overhang is shown as a hint, never as an error.</p>
        <ul class="ledger" style="margin-top:32px">
          <li><span>Geometry, fits, function blocks</span><span>PartBuddy</span></li>
          <li><span>Build volume, thin walls, bed contact, clearance</span><span>PartBuddy</span></li>
          <li><span>Supports, bridges, orientation, calibration</span><span>Your slicer</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section id="roadmap" class="section-alt">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label mono">05 · Roadmap</p>
        <h2>What comes next.</h2>
        <p>No dates. The order can change.</p>
      </div>
      <div class="roadmap">
        <article class="card reveal">
          <h3>Next</h3>
          <ul>{roadmap.next.map((r, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><span>{r}</span></li>)}</ul>
        </article>
        <article class="card reveal">
          <h3>Ideas for later</h3>
          <ul>{roadmap.later.map((r) => <li><span class="mono">–</span><span>{r}</span></li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  <section id="follow">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label mono">06 · Follow along</p>
        <h2>{RELEASED ? 'Built in public.' : 'Coming soon. Built in public.'}</h2>
        <p>New features, real printed parts, and the things that went wrong.</p>
      </div>
      <ul class="channels reveal">
        {channels.map((c) => (
          <li>
            <a class="channel" href={c.url} rel="me">
              <span><strong>{c.name}</strong><span class="mono muted">{c.handle}</span></span>
              <ArrowUpRight aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
      <p class="kofi reveal">Want to help? <a href={KOFI_URL}>Support PartBuddy on Ko-fi</a>, entirely voluntary.</p>
    </div>
  </section>

  <section id="faq" class="section-alt">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label mono">07 · FAQ</p>
        <h2>Questions.</h2>
      </div>
      <div class="faq reveal">
        {faq.map((f) => (
          <details>
            <summary>{f.q}<Plus aria-hidden="true" /></summary>
            {f.a.map((p) => <p>{p}</p>)}
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
