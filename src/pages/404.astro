---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · PartBuddy" description="This page does not exist." noindex>
  <div class="page glow-top">
    <div class="wrap">
      <header class="page-head">
        <p class="kicker">404</p>
        <h1>This page does not exist.</h1>
        <p>The link may be old or mistyped.</p>
        <div class="ctas"><a class="btn btn-primary" href="/">Go to the homepage</a></div>
      </header>
    </div>
  </div>
</Base>
