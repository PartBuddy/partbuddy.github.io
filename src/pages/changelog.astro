---
import Base from '../layouts/Base.astro';
import { releases, RELEASED, DOWNLOAD_URL } from '../config';
import { Download } from '@lucide/astro';

const description = 'Every PartBuddy release with its date and changes.';
---
<Base title="Changelog · PartBuddy" description={description}>
  <div class="page glow-top">
    <div class="wrap">
      <header class="page-head">
        <p class="kicker">Changelog</p>
        <h1>Every release, every change.</h1>
        <p>{RELEASED ? description : 'No release yet. PartBuddy is in development; the first release will appear here.'}</p>
        {RELEASED && <div class="ctas"><a class="btn btn-primary" href={DOWNLOAD_URL}><Download aria-hidden="true" />Download {releases[0].version}</a></div>}
      </header>
      {RELEASED ? releases.map((r) => (
        <section class="release" id={`v${r.version}`} aria-labelledby={`h-${r.version}`}>
          <div class="release-meta">
            <h2 id={`h-${r.version}`}><a href={`#v${r.version}`}>{r.version}</a></h2>
            <time datetime={r.date}>{r.dateLabel}</time>
          </div>
          <div class="release-body">
            {r.news && (
              <>
                <h3>What's new</h3>
                <ul>{r.news.items.map((i) => <li>{i}</li>)}</ul>
              </>
            )}
            {r.sections.length ? r.sections.map((s) => (
              <>
                <h3>{s.title}</h3>
                <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
              </>
            )) : <p class="muted">No notes.</p>}
            <p class="release-link"><a href={r.url}>Release on GitHub</a></p>
          </div>
        </section>
      )) : <p class="empty">Follow the build on <a class="link-arrow" href="/#follow">YouTube, TikTok, Instagram or Bluesky</a> to hear about the first release.</p>}
    </div>
  </div>
</Base>
