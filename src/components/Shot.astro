---
// Real app screenshot from src/assets/shots/<name>-dark.png (the site is dark), falling back to
// <name>.png. A missing file renders a clearly marked placeholder, so new material drops in without
// code changes.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// `full` skips the crop and shows the whole app window.
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; class?: string; full?: boolean }
const { name, alt, sizes = '(min-width: 1152px) 540px, (min-width: 760px) 45vw, 100vw', eager = false, class: cls, full = false } = Astro.props;

// Cropped versions (scripts/crop-shots.mjs, see src/data/crops.ts) win over the full window.
const files = import.meta.glob<{ default: ImageMetadata }>(['../assets/crops/*.png', '../assets/shots/*.{png,jpg,jpeg,webp}'], { eager: true });
const base = (p: string) => p.split('/').pop()!.replace(/\.\w+$/, '');
const find = (n: string) =>
  ((!full && Object.entries(files).find(([p]) => p.includes('/crops/') && base(p) === n)) || Object.entries(files).find(([p]) => p.includes('/shots/') && base(p) === n))?.[1].default;

const src = find(`${name}-dark`) ?? find(name);
const widths = src ? [480, 800, 1200, 1600, 2400].filter((w) => w <= src.width) : [];
const [avif, webp] = src
  ? await Promise.all((['avif', 'webp'] as const).map((format) => getImage({ src, widths, format, quality: 72 })))
  : [];
---
{src && avif && webp ? (
  <div class:list={['frame', cls]}>
    <picture>
      <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
      <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
      <img src={webp.src} alt={alt} width={src.width} height={src.height}
        loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : 'auto'} />
    </picture>
  </div>
) : (
  <div class:list={['placeholder', cls]} role="img" aria-label={`Screenshot coming soon: ${alt}`}>
    <span><strong>Screenshot pending</strong><br /><span class="mono">src/assets/shots/{name}.png</span></span>
  </div>
)}
