---
// Real app screenshot from src/assets/shots/<name>.png (optional <name>-dark.png for the dark theme).
// A missing file renders a clearly marked placeholder, so new material drops in without code changes.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: string; alt: string; sizes?: string; eager?: boolean; class?: string }
const { name, alt, sizes = '(min-width: 1152px) 540px, (min-width: 760px) 45vw, 100vw', eager = false, class: cls } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.{png,jpg,jpeg,webp}', { eager: true });
const find = (n: string) =>
  Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === n)?.[1].default;

async function variant(src: ImageMetadata) {
  const widths = [480, 800, 1200, 1600, 2400].filter((w) => w <= src.width);
  const [avif, webp] = await Promise.all(
    (['avif', 'webp'] as const).map((format) => getImage({ src, widths, format, quality: 72 })),
  );
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, fallback: webp.src, width: src.width, height: src.height };
}
const light = find(name);
const dark = find(`${name}-dark`);
const variants = [
  ...(light ? [{ v: await variant(light), cls: dark ? 'show-light' : '' }] : []),
  ...(dark ? [{ v: await variant(dark), cls: 'show-dark' }] : []),
];
---
{variants.length ? (
  <div class:list={['frame', cls]}>
    {variants.map(({ v, cls: c }) => (
      <picture class={c}>
        <source type="image/avif" srcset={v.avif} sizes={sizes} />
        <source type="image/webp" srcset={v.webp} sizes={sizes} />
        <img src={v.fallback} alt={alt} width={v.width} height={v.height}
          loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : 'auto'} />
      </picture>
    ))}
  </div>
) : (
  <div class:list={['placeholder', cls]} role="img" aria-label={`Screenshot coming soon: ${alt}`}>
    <span><strong>Screenshot pending</strong><br /><span class="mono">src/assets/shots/{name}.png</span></span>
  </div>
)}
