---
import '../styles/global.css';
import { RELEASED, SITE_URL, DOWNLOAD_URL, GOATCOUNTER_URL } from '../config';
import { channels, KOFI_URL } from '../data/site';
import Brand from '../components/Brand.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
  jsonLd?: object;
  noindex?: boolean;
}
const { title, description, lang = 'en', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/index(\.html)?$/, ''), SITE_URL).href;
const image = `${SITE_URL}/og.png`;
const home = import.meta.env.BASE_URL;
// On the homepage the section links stay on the page; elsewhere they lead back to it.
const onHome = Astro.url.pathname === home || Astro.url.pathname === `${home}index.html`;
const to = (hash: string) => (onHome ? hash : `${home}${hash}`);
const cta = RELEASED ? { href: DOWNLOAD_URL, label: 'Download' } : { href: to('#follow'), label: 'Follow the build' };
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#08090b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="PartBuddy" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="PartBuddy: Parts that fit. First print. The app window with a housing in the 3D view and the assistant's questions." />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {GOATCOUNTER_URL && <script is:inline async src={`${GOATCOUNTER_URL}/count.js`} data-goatcounter={`${GOATCOUNTER_URL}/count`}></script>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={home} aria-label="PartBuddy home">
        <img src="/logo-inverse.svg" alt="PartBuddy" width="103" height="24" />
      </a>
      <nav class="nav" aria-label="Main">
        <a href={to('#product')}>Product</a>
        <a href={to('#compare')}>Compare</a>
        <a href="/changelog.html">Changelog</a>
        <a href={to('#faq')}>FAQ</a>
        <a class="nav-kofi" href={KOFI_URL}><Brand name="Ko-fi" />Support</a>
      </nav>
      <a class="btn btn-sm" href={cta.href} data-goatcounter-click={RELEASED ? 'download-windows' : undefined}>{cta.label}</a>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div class="footer-brand">
          <img src="/logo-inverse.svg" alt="PartBuddy" width="94" height="22" loading="lazy" />
          <p>Free CAD for FDM printing, with an assistant that asks before it builds. Built in public in Austria.</p>
        </div>
        <nav aria-labelledby="f-product">
          <h2 id="f-product">Product</h2>
          <ul>
            <li><a href={to('#product')}>Features</a></li>
            <li><a href={to('#compare')}>Compare</a></li>
            <li><a href="/changelog.html">Changelog</a></li>
            <li><a href={to('#faq')}>FAQ</a></li>
          </ul>
        </nav>
        <nav aria-labelledby="f-follow">
          <h2 id="f-follow">Follow</h2>
          <ul>
            {channels.map((c) => <li><a href={c.url} rel="me"><Brand name={c.name} />{c.name}</a></li>)}
            <li><a href={KOFI_URL}><Brand name="Ko-fi" />Ko-fi</a></li>
          </ul>
        </nav>
        <nav aria-labelledby="f-legal">
          <h2 id="f-legal">Legal</h2>
          <ul>
            <li><a href="/privacy.html">Privacy policy</a></li>
            <li><a href="/imprint.html">Imprint</a></li>
          </ul>
        </nav>
      </div>
      <div class="footer-base">
        <span>{RELEASED ? 'Free and open source under GPL-3.0.' : 'Free. In development.'}</span>
        <span>{GOATCOUNTER_URL ? 'No cookies. Anonymous visitor counts through GoatCounter.' : 'No cookies, no tracking, nothing loaded from other servers.'}</span>
      </div>
    </div>
  </footer>
</body>
</html>
